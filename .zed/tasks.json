[
    {
        "label": "R terminal",
        "command": "pixi run R",
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": true
    },
    {
        "label": "Source current R file",
        "command": "pixi run Rscript -e \"source('$ZED_RELATIVE_FILE', echo = TRUE)\"",
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "show_output": true,
        "show_error": true
    },
    {
        "label": "Render current qmd",
        "command": "pixi run quarto render \"$ZED_RELATIVE_FILE\"",
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "show_output": true,
        "show_error": true
    }
]
