{
  "name": "quarto-r-slides",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/r-apt:0": {
      "vscodeRSupport": "full",
      "installRMarkdown": true,
      "installBspm": true,
      "installRadian": true
    },
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "jq,curl,wget,git,make,build-essential,pkg-config,python3,python3-venv,python3-dev,fontconfig,fonts-noto,fonts-noto-cjk,fonts-noto-color-emoji,libcurl4-openssl-dev,libssl-dev,libxml2-dev,libfontconfig1-dev,libfreetype6-dev,libharfbuzz-dev,libfribidi-dev,libpng-dev,libjpeg-dev,libtiff5-dev",
      "upgradePackages": false
    },
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {
      "version": "latest",
      "installTinyTex": false,
      "installChromium": true
    },
    "ghcr.io/rocker-org/devcontainer-features/rstudio-server:0": {
      "version": "stable",
      "singleUser": true
    }
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/rocker-org/devcontainer-features/r-apt",
    "ghcr.io/rocker-org/devcontainer-features/apt-packages",
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli",
    "ghcr.io/rocker-org/devcontainer-features/rstudio-server"
  ],
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "REditorSupport.r",
        "ms-python.python",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.associations": {
          "*.qmd": "quarto"
        }
      }
    }
  },
  "forwardPorts": [
    4444,
    8000,
    8787
  ],
  "portsAttributes": {
    "4444": {
      "label": "Quarto preview",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "Static docs preview",
      "onAutoForward": "notify"
    },
    "8787": {
      "label": "RStudio Server",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "postAttachCommand": {
    "rstudio-server": "pgrep -x rserver >/dev/null || rserver"
  }
}