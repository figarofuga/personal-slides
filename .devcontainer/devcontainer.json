{
  "name": "quarto-r-slides",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/r-apt:0": {
      "vscodeRSupport": "full",
      "installRMarkdown": true,
      "installBspm": true
    },
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "jq,curl,wget,git,make,build-essential,pkg-config,python3,python3-venv,python3-dev,fontconfig,fonts-noto,fonts-noto-cjk,fonts-noto-color-emoji,r-cran-here,r-cran-glue,r-cran-knitr,r-cran-rmarkdown,r-cran-reticulate,r-cran-tidyverse,r-cran-easystats,r-cran-tidymodels,r-cran-bonsai,r-cran-lightgbm,r-cran-scales,r-cran-tinytable,r-cran-tinyplot,r-cran-survival,r-cran-plotly,r-cran-xgboost,r-cran-marginaleffects,r-cran-matchit,r-cran-rootsolve,r-cran-weightit,r-cran-modelsummary,r-cran-rms,r-cran-hmisc,r-cran-grf,r-cran-dagitty,r-cran-ggdag,r-cran-sessioninfo,r-cran-grid,",
      "upgradePackages": false
    },
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {
      "version": "latest",
      "installTinyTex": false,
      "installChromium": true
    },
    "ghcr.io/rocker-org/devcontainer-features/rstudio-server:0": {
      "version": "stable",
      "singleUser": true
    }
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/rocker-org/devcontainer-features/r-apt",
    "ghcr.io/rocker-org/devcontainer-features/apt-packages",
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli",
    "ghcr.io/rocker-org/devcontainer-features/rstudio-server"
  ],
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "REditorSupport.r",
        "ms-python.python",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.associations": {
          "*.qmd": "quarto"
        }
      }
    }
  },
  "forwardPorts": [4444, 8000, 8787],
  "portsAttributes": {
    "4444": {
      "label": "Quarto preview",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "Static docs preview",
      "onAutoForward": "notify"
    },
    "8787": {
      "label": "RStudio Server",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "postAttachCommand": {
    "rstudio-server": "pgrep -x rserver >/dev/null || rserver"
  }
}