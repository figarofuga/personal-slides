{
  "name": "personal-slides-analysis",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },

  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "postCreateCommand": "bash .devcontainer/setup.sh --base-only",
  "waitFor": "updateContentCommand",

  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "REditorSupport.r",
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },

  "mounts": [
    "source=${localWorkspaceFolderBasename}-pixi,target=${containerWorkspaceFolder}/.pixi,type=volume"
  ]
}
