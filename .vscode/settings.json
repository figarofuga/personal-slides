{
    "positron.r.interpreters.pixiDiscovery": false,
    "positron.r.customBinaries": [
        "/home/figarofuga/analysis/pixi-test/.pixi/envs/default/bin/R"
    ],
    "positron.r.interpreters.default": "/home/figarofuga/analysis/pixi-test/.pixi/envs/default/bin/R",

    "files.exclude": {
        "**/.pixi": true
    },

    "files.watcherExclude": {
        "**/.pixi/**": true,
        "**/.quarto/**": true,
        "**/docs/**": true,
        "**/index_cache/**": true
    },
    "search.exclude": {
        "**/.pixi/**": true,
        "**/.quarto/**": true,
        "**/docs/**": true,
        "**/index_cache/**": true
    },
    "python.analysis.exclude": [
        ".pixi",
        ".quarto",
        "docs",
        "**/index_cache"
    ],
    "python.analysis.indexing": false,
    "terminal.integrated.env.linux": {
        "PIXI_NO_INSTALL": "true",
        "PIXI_FROZEN": "true"
    },
    "python.pyrefly.disableTypeErrors": true,
    "quarto.cells.diagnostics.enabled": false,

    "r.executablePath": "${workspaceFolder}/.pixi/envs/default/bin/R",
    "r.consolePath": "${workspaceFolder}/scripts/arf-pixi.sh",
    "r.consoleArgs": ["--no-save", "--no-restore"],
    "r.sessionWatcher": true,
    "r.plot.backend": "httpgd",
    "r.lsp.diagnostics": false,
    "r.bracketedPaste": true,


    "positron.r.diagnostics.enable": false, 
    "quarto.symbols.showCodeCellsInOutline": false
}
