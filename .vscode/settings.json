{
    "positron.r.interpreters.pixiDiscovery": true,

    "files.watcherExclude": {
        "**/.pixi/**": true,
        "**/.quarto/**": true,
        "**/docs/**": true,
        "**/index_cache/**": true
    },
    "search.exclude": {
        "**/.pixi/**": true,
        "**/.quarto/**": true,
        "**/docs/**": true,
        "**/index_cache/**": true
    },
    "python.analysis.exclude": [
        ".pixi",
        ".quarto",
        "docs",
        "**/index_cache"
    ],
    "python.analysis.indexing": false,
    "quarto.cells.diagnostics.enabled": false,

    "r.rpath.linux": "${workspaceFolder}/.pixi/envs/default/bin/R",
    "r.rterm.linux": "${workspaceFolder}/.pixi/envs/default/bin/radian",
    "r.lsp.diagnostics": false
}
